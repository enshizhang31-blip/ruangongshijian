# ============================================
# 生产环境变量模板
# 复制为 .env 并修改密码和密钥
#   cp .env.example .env
# ============================================

# MySQL
MYSQL_ROOT_PASSWORD=请修改为强密码
MYSQL_DATABASE=sale_manager
MYSQL_USER=salemanager
MYSQL_PASSWORD=请修改为强密码
MYSQL_PORT=3306

# MongoDB
MONGO_USER=salemanager
MONGO_PASSWORD=请修改为强密码
MONGO_DATABASE=sale_manager
MONGO_PORT=27017

# Redis
REDIS_PASSWORD=请修改为强密码
REDIS_PORT=6379

# JWT
JWT_SECRET=请修改为至少32位随机字符串
